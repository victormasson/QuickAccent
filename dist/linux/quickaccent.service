[Unit]
Description=QuickAccent accent character picker
Documentation=https://github.com/victormasson/QuickAccent
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/quickaccent
Restart=on-failure
RestartSec=2
Environment=PATH=/usr/bin:/usr/local/bin:%h/.local/bin

[Install]
WantedBy=graphical-session.target
